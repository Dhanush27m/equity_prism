# Component: Backend -> Deployment -> Lightweight production image
# Belongs to: the image actually deployed to Render (declared in render.yaml) — this is
# the concrete artifact behind the "~85% smaller image" hosted-profile story.
# Purpose: builds a torch-free backend image — installs requirements-hosted.txt (no
# sentence-transformers/torch) and bakes in the env vars that switch the app into its
# hosted profile at the image level (fastembed embeddings, reranker off, in-memory
# cache, background-task ingestion, /tmp-based writable dirs for Render's read-only
# filesystem elsewhere).
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/tmp/hf \
    FASTEMBED_CACHE_PATH=/tmp/fastembed \
    UPLOAD_DIR=/tmp/uploads \
    CACHE_BACKEND=memory \
    INGEST_MODE=background \
    EMBEDDING_BACKEND=fastembed \
    RERANK_ENABLED=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-hosted.txt .
RUN pip install --upgrade pip && pip install -r requirements-hosted.txt

COPY . .

RUN sed -i 's/\r$//' start.sh && mkdir -p /tmp/uploads && chmod -R 777 /tmp/uploads

EXPOSE 7860

CMD ["sh", "start.sh"]
