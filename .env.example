# Equity Prism — environment variables (LOCAL ONLY)
# Copy to .env and fill in the secrets marked <ASK USER>. Never commit .env.

# ── PostgreSQL (timescale/timescaledb-ha:pg16) ─────────────────
POSTGRES_USER=equityprism
POSTGRES_PASSWORD=change_me_local_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
APP_DB_NAME=equity_prism
LANGFUSE_DB_NAME=langfuse

# App database (async driver for FastAPI/SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://equityprism:change_me_local_dev@db:5432/equity_prism
# App database (sync driver for Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg://equityprism:change_me_local_dev@db:5432/equity_prism

# ── Redis 7 (cache + Celery broker/result) ─────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── LLM: Groq (primary) → Ollama (fallback) ────────────────────
GROQ_API_KEY=                       # <ASK USER> https://console.groq.com (fresh email)
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ── LangFuse self-hosted (server) ──────────────────────────────
LANGFUSE_DATABASE_URL=postgresql://equityprism:change_me_local_dev@db:5432/langfuse
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=change_me_local_dev
LANGFUSE_SALT=change_me_local_dev
# LangFuse client SDK keys (create in the LangFuse UI in Phase 4)
LANGFUSE_PUBLIC_KEY=                 # <ASK USER> from LangFuse Project Settings
LANGFUSE_SECRET_KEY=                 # <ASK USER> from LangFuse Project Settings
LANGFUSE_HOST=http://langfuse:3000

# ── RAG / embedding models (run locally, no API) ───────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── App ────────────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# ── Hosted profile (leave defaults for LOCAL; set on the cloud host) ──
# These let the SAME code run on Render + Supabase + Vercel.
# Local docker compose does not need any of them.
#
# CACHE_BACKEND=redis        # "redis" (local) or "memory" (hosted, no Redis)
# INGEST_MODE=celery         # "celery" (local worker) or "background" (hosted, in-process)
# DB_POOLED=false            # true when using Supabase's pooled connection (asyncpg statement_cache_size=0)
# DB_SSL=false               # true for managed Postgres that requires SSL (Supabase)
# ACCESS_KEY=                # set a shared password to gate the public API (empty = open)
# CORS_ORIGINS=*             # comma-separated allowed origins, e.g. https://your-app.vercel.app
# RUN_MIGRATIONS=0           # set 1 on the host to run `alembic upgrade head` at startup
#
# On Supabase, DATABASE_URL / DATABASE_URL_SYNC point at your project, e.g.:
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_URL_SYNC=postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
