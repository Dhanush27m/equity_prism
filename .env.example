# Equity Prism — LOCAL-ONLY environment
# Copy to .env and fill in the secrets marked <CHANGE>. Never commit .env.

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=equityprism
POSTGRES_PASSWORD=change_me_local_dev    # <CHANGE>
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
APP_DB_NAME=equity_prism

DATABASE_URL=postgresql+asyncpg://equityprism:change_me_local_dev@localhost:5432/equity_prism
DATABASE_URL_SYNC=postgresql+psycopg://equityprism:change_me_local_dev@localhost:5432/equity_prism

# ── LLM: Ollama (local) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── Cache & ingestion (in-memory, no Redis/Celery needed) ──────
CACHE_BACKEND=memory
INGEST_MODE=background

# ── RAG ────────────────────────────────────────────────────────
EMBEDDING_BACKEND=local
RERANK_ENABLED=true
